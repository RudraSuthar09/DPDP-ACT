{
  "name": "@dpdp/api",
  "version": "0.1.0",
  "private": true,
  "description": "DPDP Platform backend — NestJS modular monolith (app + worker).",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "nest start --entryFile worker --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests",
    "test:isolation": "jest --config jest.isolation.config.js",
    "test:isolation:local": "dotenv -e ../.env -- jest --config jest.isolation.config.js",
    "migrate": "dotenv -e ../.env -- node-pg-migrate",
    "migrate:up": "dotenv -e ../.env -- node-pg-migrate up",
    "migrate:down": "dotenv -e ../.env -- node-pg-migrate down",
    "migrate:create": "node-pg-migrate create --migration-file-language sql"
  },
  "dependencies": {
    "@dpdp/shared": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "bullmq": "^5.20.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^7.4.2",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.7.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
