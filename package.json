{
  "name": "dpdp-platform",
  "version": "0.1.0",
  "private": true,
  "description": "DPDP Compliance Platform — Stage 1 modular monolith (NestJS + Next.js + Postgres)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "doctor": "node scripts/doctor.mjs",
    "db:local": "node scripts/local-db.mjs",
    "db:local:reset": "node scripts/local-db.mjs --reset",
    "dev:api": "pnpm --filter @dpdp/api dev",
    "dev:web": "pnpm --filter @dpdp/web dev",
    "smoke": "node scripts/smoke.mjs",
    "request:demo": "node scripts/request-substrate-demo.mjs",
    "migrate": "pnpm --filter @dpdp/api migrate",
    "migrate:up": "pnpm --filter @dpdp/api migrate:up",
    "migrate:down": "pnpm --filter @dpdp/api migrate:down",
    "dpr:demo": "node scripts/dprequest-demo.mjs",
    "dpr:e2e": "node scripts/dprequest-e2e.mjs",
    "dpr:summary": "node scripts/dpr-summary-demo.mjs",
    "breach:demo": "node scripts/breach-demo.mjs",
    "breach:ui": "node scripts/breach-ui.spec.mjs",
    "audit:gap:demo": "node scripts/audit-worker-gap-demo.mjs",
    "notify:evidence:demo": "node scripts/notify-and-evidence-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "pg": "^8.13.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
