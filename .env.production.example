# ---------------------------------------------------------------------------
# DPDP Platform — PRODUCTION environment TEMPLATE (AWS ap-south-1, ECS Fargate).
# Reference only.
#
# Do NOT copy this to a .env on a server. Every SECRET below lives in AWS
# Secrets Manager and is injected into the container at RUNTIME; the
# non-secret settings go in the task definition. The ready-made templates are
# deploy/aws/ecs/*.json, and a test (backend/src/config/aws-deploy-templates.spec.ts)
# keeps them honest. Nothing here is ever a Docker build arg, except the
# frontend's two PUBLIC values at the bottom.
#
# With NODE_ENV=production the backend refuses to start on any published dev
# placeholder, a JWT secret under 32 characters, a malformed key or an
# unreadable CA bundle — and lists every problem at once.
# See docs/environment-variables.md and docs/aws-deployment.md.
# ---------------------------------------------------------------------------

# ===========================================================================
# BACKEND API — node dist/main.js
# ===========================================================================
NODE_ENV=production
API_PORT=3001
AWS_REGION=ap-south-1

# --- secrets (Secrets Manager) ---------------------------------------------
# Runtime role dpdp_app (RLS-enforced).
APP_DATABASE_URL=
# pg-boss on its own role, dpdp_jobs, which owns ONLY the pgboss schema
# (docs/pgboss-least-privilege.sql). With this set, the running app never
# holds the owner credential; DATABASE_URL is not given to the API or worker.
PGBOSS_DATABASE_URL=
# >= 32 random characters:  openssl rand -hex 32
JWT_SECRET=
REQUEST_OTP_SECRET=
# EXACTLY 32 bytes, base64. MUST be the same value on every runtime that
# shares this database (API, worker, customer installations) — copy the
# existing value; a new one makes existing data undecryptable.
MFA_SECRET_ENC_KEY=
SUBMISSION_STAGING_ENC_KEY=
# Real providers. Without them e-mail/SMS (one-time codes included) reach
# nobody — the backend warns at startup.
POSTMARK_API_KEY=
MSG91_AUTH_KEY=

# --- settings (task definition) --------------------------------------------
# Verifies the RDS server certificate AND hostname. The bundle is shipped in
# the backend image, pinned by checksum. TLS parameters inside the URLs are
# ignored while this is set, so no URL can switch verification off.
DATABASE_SSL_CA_FILE=/opt/dpdp/certs/rds-global-bundle.pem
WEB_ORIGIN=https://app.example.com
# Behind one ALB. Never "true" (trusts any client-supplied X-Forwarded-For).
TRUST_PROXY=1
DB_POOL_MAX=10
MFA_ISSUER=DPDP Platform
NOTIFY_TRANSPORT=console
POSTMARK_FROM_EMAIL=notifications@example.com
MSG91_SENDER_ID=
NOTIFY_DEV_ECHO_OTP=false
# CSV/Excel import evidence: encrypted, write-once S3 objects. The task ROLE
# needs s3:PutObject (+ s3:PutObjectRetention with retention) on this prefix,
# and kms:GenerateDataKey on the key. No access keys anywhere.
IMPORT_EVIDENCE_STORE=s3
IMPORT_EVIDENCE_S3_BUCKET=dpdp-prod-import-evidence
IMPORT_EVIDENCE_S3_PREFIX=inventory-import-evidence/
IMPORT_EVIDENCE_S3_KMS_KEY_ID=arn:aws:kms:ap-south-1:<ACCOUNT_ID>:key/<KEY_ID>
# Object Lock retention per object. The bucket must be CREATED with Object
# Lock enabled; uploads fail (and the import is refused) otherwise.
IMPORT_EVIDENCE_RETENTION_DAYS=2555
IMPORT_EVIDENCE_OBJECT_LOCK_MODE=COMPLIANCE

# ===========================================================================
# WORKER — node dist/worker.js (same image). EXACTLY ONE.
# ===========================================================================
# Needs: NODE_ENV, AWS_REGION, APP_DATABASE_URL, PGBOSS_DATABASE_URL,
# DATABASE_SSL_CA_FILE, MFA_SECRET_ENC_KEY (it decrypts webhook signing
# secrets), DB_POOL_MAX, and the NOTIFY_* / POSTMARK_* / MSG91_* settings.
# It does NOT need JWT_SECRET, REQUEST_OTP_SECRET, SUBMISSION_STAGING_ENC_KEY
# or any IMPORT_EVIDENCE_* — do not grant them.
#
# One worker: the ECS service has desiredCount 1 and maximumPercent 100, and
# the worker itself takes a database lock before starting anything — a second
# worker, however it was started, stands by instead of running.

# ===========================================================================
# MIGRATION TASK — one-off, same image
# ===========================================================================
# The ONLY place the owner credential is used. node-pg-migrate reads TLS from
# the URL itself, so verification is spelled out in it:
#   DATABASE_URL=postgresql://dpdp_owner:<pw>@<rds-endpoint>:5432/dpdp?sslmode=verify-full&sslrootcert=/opt/dpdp/certs/rds-global-bundle.pem
# Command: node-pg-migrate up, then node dist/pgboss-install.js
# (deploy/aws/ecs/task-def-migrate.json).

# ===========================================================================
# FRONTEND — PUBLIC BUILD-TIME values (docker build --build-arg)
# ===========================================================================
# Baked into the browser bundle: readable by every visitor. Never a secret.
# One frontend image per environment.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_REQUIRE_ACTIVATION=false

# --- FRONTEND runtime (task definition; server-only) -----------------------
# Where the frontend's own server reaches the API for server-rendered public
# pages (/forms/*, /portal/*). (The frontend also runs with NODE_ENV=production.)
INTERNAL_API_URL=https://api.example.com

# ===========================================================================
# GATEWAY — not deployed to AWS
# ===========================================================================
# The Gateway runs on each customer's own Windows machine (gateway-installer).
# Its only link to this deployment is the API's public HTTPS address.
