# ---------------------------------------------------------------------------
# DPDP Platform — LOCAL DEVELOPMENT environment.
#
#   cp .env.example .env        then fill in the database URLs.
#
# For production use .env.production.example instead; it has no defaults.
# NEVER commit a real .env (see .gitignore, NFR-SEC-04).
#
# Every value below is either a harmless local default or a published dev
# placeholder. The backend REFUSES these placeholders when NODE_ENV=production
# (backend/src/config/env.validation.ts) — they cannot leak into a real
# deployment by accident.
#
# Full reference, including who reads each variable and which are public:
# docs/environment-variables.md
# ---------------------------------------------------------------------------

# development locally. docker-compose.yml sets this for backend/worker itself.
NODE_ENV=development

# ===========================================================================
# DATABASE — backend API + worker (server-only)
# ===========================================================================
# Roles, on purpose (Seam S1):
#   * owner      — owns the schema. Runs MIGRATIONS. Locally it also runs
#                  pg-boss (the job queue) unless PGBOSS_DATABASE_URL is set.
#   * dpdp_app   — least-privilege runtime role (NOSUPERUSER NOBYPASSRLS, not
#                  the table owner). Every tenant query uses it, so RLS is
#                  always enforced. Created by the bootstrap migration.
#   * dpdp_jobs  — optional (production): owns ONLY the `pgboss` schema, so the
#                  running app never holds the owner credential.
#                  docs/pgboss-least-privilege.sql
#
# Point these at your dev database. The hosted dev instance needs
# `?sslmode=no-verify` (or a CA bundle, below).
DATABASE_URL=postgresql://dpdp:dpdp_local_dev_only@localhost:5432/dpdp
APP_DATABASE_URL=postgresql://dpdp_app:dpdp_app_local_dev_only@localhost:5432/dpdp
# PGBOSS_DATABASE_URL=postgresql://dpdp_jobs:<password>@localhost:5432/dpdp

# Verify the database server's certificate (and hostname) against this CA
# bundle. Production on AWS: /opt/dpdp/certs/rds-global-bundle.pem (shipped in
# the backend image). Unset = connections use whatever the URLs say.
# DATABASE_SSL_CA_FILE=

# Optional: per-process size of the dpdp_app pool (default 10).
# DB_POOL_MAX=10

# Only for `docker compose --profile local-db up postgres` (a local Postgres
# container). Not read by the application.
POSTGRES_USER=dpdp
POSTGRES_PASSWORD=dpdp_local_dev_only
POSTGRES_DB=dpdp
POSTGRES_PORT=5432

# ===========================================================================
# API — backend (server-only)
# ===========================================================================
API_PORT=3001

# The dashboard origin(s) the API accepts browser calls from (CORS), comma-
# separated, exact scheme://host[:port]. Also sent to enrolled Gateways as the
# origins their local listener should accept. Default: http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Number of reverse-proxy hops in front of the API (a load balancer = 1), so
# per-IP rate limits see the real client. Leave unset locally.
# TRUST_PROXY=1

# ===========================================================================
# SECRETS — backend (server-only)
# ===========================================================================
# Signs every session token, invitation and Gateway device token, and their
# tenant claim (Seam S1). Anyone holding it can act as ANY tenant.
#
# DELIBERATELY EMPTY: there is no safe shared default, and a value printed in
# a public file is not a secret. The API will not start until you generate
# your own — one command, never printed:
#
#     node scripts/rotate-jwt-secret.mjs
#
JWT_SECRET=

# HMAC key for portal one-time codes at rest. Falls back to JWT_SECRET if
# unset; set it separately anywhere real (different rotation story).
# REQUEST_OTP_SECRET=

# AES-256 keys: EXACTLY 32 bytes, base64. The values below are a PUBLIC dev
# pair, acceptable ONLY for a database nobody else uses; production refuses
# them. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Both encrypt data AT REST IN THE SHARED DATABASE, so every runtime that
# connects to the same database must hold the SAME value — never generate a
# fresh one per machine. Rotating either means re-encrypting data.
#   MFA_SECRET_ENC_KEY          TOTP secrets, per-tenant subject-ref secrets,
#                               webhook signing secrets.
#   SUBMISSION_STAGING_ENC_KEY  consent-form values/files staged for a
#                               tenant's Gateway. A separate key on purpose.
MFA_SECRET_ENC_KEY=Q2hhbmdlTWVEZXZPbmx5S2V5Rm9yTG9jYWxVc2UhISE=
SUBMISSION_STAGING_ENC_KEY=Q2hhbmdlTWVEZXZPbmx5S2V5Rm9yTG9jYWxVc2UhISE=

# The name shown in the user's authenticator app.
MFA_ISSUER=DPDP Platform

# ===========================================================================
# CSV/EXCEL IMPORT EVIDENCE — backend API (server-only)
# ===========================================================================
# local (default): files under backend/var on this machine. Fine locally;
# NOT durable on a container platform. s3: encrypted, write-once objects.
IMPORT_EVIDENCE_STORE=local
# IMPORT_EVIDENCE_S3_BUCKET=
# IMPORT_EVIDENCE_S3_PREFIX=inventory-import-evidence/
# IMPORT_EVIDENCE_S3_KMS_KEY_ID=          (unset = SSE-S3)
# IMPORT_EVIDENCE_RETENTION_DAYS=         (Object Lock; bucket must have it enabled)
# IMPORT_EVIDENCE_OBJECT_LOCK_MODE=COMPLIANCE
# Region and credentials for S3 come from the AWS SDK default chain (AWS_REGION
# + an IAM role). Never put access keys here.

# ===========================================================================
# TOKEN LIFETIMES — backend (optional; defaults shown)
# ===========================================================================
# There is no revocation list, so the access-token lifetime IS the blast
# radius of a leaked token. ~6 months by product decision (license term).
ACCESS_TOKEN_TTL_SECONDS=15552000
MFA_CHALLENGE_TTL_SECONDS=300
# INVITE_TOKEN_TTL_SECONDS=604800
# PLATFORM_ADMIN_TOKEN_TTL_SECONDS=43200
# GATEWAY_DEVICE_TOKEN_TTL_SECONDS=2592000
# GATEWAY_ENROLLMENT_CODE_TTL_SECONDS=900

# ===========================================================================
# NOTIFICATIONS — backend (server-only)
# ===========================================================================
#   console — log it (full text in development; redacted in production, and
#             then NOT delivered to anyone). The default.
#   http    — POST each message as JSON to NOTIFY_HTTP_ENDPOINT.
NOTIFY_TRANSPORT=console
# NOTIFY_HTTP_ENDPOINT=https://relay.internal.example/dpdp-notifications

# Real providers, used ahead of the transport above when BOTH values of a pair
# are set. Unset either and that channel falls back to NOTIFY_TRANSPORT.
# POSTMARK_API_KEY=
# POSTMARK_FROM_EMAIL=notifications@yourdomain.example
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=

# DANGEROUS, DEV ONLY: echoes portal one-time codes back in the HTTP response
# so a demo works without an inbox. Ignored when NODE_ENV=production.
NOTIFY_DEV_ECHO_OTP=false

# ===========================================================================
# FRONTEND
# ===========================================================================
# PUBLIC, BUILD-TIME. Baked into the browser bundle by `next build` — every
# visitor can read it, so never put a secret in a NEXT_PUBLIC_ variable.
# Changing it means rebuilding the frontend image.
NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_GATEWAY_AGENT_URL=http://127.0.0.1:7071
# NEXT_PUBLIC_REQUIRE_ACTIVATION=false     (customer installer build only)

# SERVER-ONLY, RUNTIME. Where the frontend's own server reaches the API for
# server-rendered public pages. docker-compose.yml sets it (http://backend:3001);
# leave unset for plain `pnpm dev`.
# INTERNAL_API_URL=http://backend:3001

WEB_PORT=3000

# ===========================================================================
# LOCAL DOCKER ONLY — host folders bind-mounted by docker-compose.yml
# ===========================================================================
# ENTERPRISE_STORAGE_HOST_DIR=E:\DPDP-Enterprise-Test
# GATEWAY_STORAGE_HOST_DIR=E:\DPDP-Test-Storage
# AGENT_DELIVERY_HOST_DIR=E:\DPDP-Delivery-Test

# The test Gateway container's settings live in docker-compose.yml, and the
# Windows Gateway's in agent/.env.example and its own config.json — the
# Gateway runs on the customer's computer, never in the cloud deployment.
