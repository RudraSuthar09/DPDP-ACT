# ---------------------------------------------------------------------------
# DPDP Platform — Stage 1 environment. Copy to `.env` and fill in.
# NEVER commit a real .env (see .gitignore, NFR-SEC-04).
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Postgres (single DB, RLS-enforced) ------------------------------------
# TWO roles, on purpose (Seam S1):
#   * dpdp      — owner/superuser. Runs MIGRATIONS ONLY (DDL). Bypasses RLS.
#   * dpdp_app  — least-privilege runtime role (NOSUPERUSER NOBYPASSRLS, not the
#                 table owner). The APP connects as this so RLS is ALWAYS
#                 enforced. Created idempotently by the bootstrap migration.
POSTGRES_USER=dpdp
POSTGRES_PASSWORD=dpdp_local_dev_only
POSTGRES_DB=dpdp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Admin/owner connection — used by node-pg-migrate (migrations) only:
DATABASE_URL=postgresql://dpdp:dpdp_local_dev_only@localhost:5432/dpdp

# Runtime connection — used by the API/worker. RLS is enforced against this role.
# Password must match the one the bootstrap migration creates for dev/CI.
APP_DATABASE_URL=postgresql://dpdp_app:dpdp_app_local_dev_only@localhost:5432/dpdp

# --- Redis (BullMQ jobs/deadlines behind WorkflowRunner S3, cache) ---------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ---------------------------------------------------------------------
API_PORT=3001

# --- Web ---------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Secrets (placeholders — move to Vault before any real deployment) -----
# Per-tenant HMAC pepper for subject-ref pseudonymisation (I2). Rotatable.
SUBJECT_REF_HMAC_PEPPER=change_me_dev_pepper
# JWT signing secret for tenant context propagation (S1). This key signs the
# `tenant_id` claim, so anyone holding it can mint a token for ANY tenant —
# treat it as the single most sensitive secret in the deployment.
JWT_SECRET=change_me_dev_jwt_secret

# --- Identity (FR-IDN-01/02/03) ---------------------------------------------
# Encrypts TOTP secrets at rest (NFR-SEC-03). MUST be exactly 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates every enrolled authenticator (users must re-enrol),
# so a real rotation story means re-encrypting the column — not just a new value.
MFA_SECRET_ENC_KEY=Q2hhbmdlTWVEZXZPbmx5S2V5Rm9yTG9jYWxVc2VPbmx5ISE=

# The name shown in the user's authenticator app next to their code.
MFA_ISSUER=DPDP Platform

# Access token lifetime. There is no revocation list in Stage 1, so this number
# IS the blast radius of a leaked token (and how long a just-suspended user can
# still act). Keep it short.
ACCESS_TOKEN_TTL_SECONDS=900
# Lifetime of the half-finished login between password and MFA code.
MFA_CHALLENGE_TTL_SECONDS=300

# --- Notifications (FR-GRV-01/05, FR-DSH-02/03) ------------------------------
# How transactional email/SMS actually leaves the process.
#   console — log it. Dev, CI, demos. The default.
#   http    — POST the message as JSON to NOTIFY_HTTP_ENDPOINT, so ops can wire
#             MSG91 / Gupshup / SES / a relay of their choice without this
#             repository taking a dependency on any provider SDK.
NOTIFY_TRANSPORT=console
# NOTIFY_HTTP_ENDPOINT=https://relay.internal.example/dpdp-notifications

# DANGEROUS, DEV ONLY. Echoes a freshly-minted one-time code back in the portal's
# HTTP response, so the end-to-end demo can complete an OTP round-trip without an
# inbox. It turns "possession of the mailbox" into "possession of nothing", so it
# is off by default and is refused outright when NODE_ENV=production.
NOTIFY_DEV_ECHO_OTP=false

# --- Public request portal (FR-GRV-01/04) ------------------------------------
# HMAC key for one-time codes at rest. A six-digit code beside a known ticket id
# is a million candidates, so a bare digest column would be reversible from a
# database dump in about a second; this key lives outside the database so a dump
# alone yields nothing. Falls back to JWT_SECRET if unset — set it separately in
# any real deployment, because the two have different rotation stories.
REQUEST_OTP_SECRET=change_me_dev_otp_secret
