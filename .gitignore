# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# test / coverage
coverage/
.turbo/
test-results/
playwright-report/

# env & secrets — NEVER commit real secrets (NFR-SEC-04)
.env
.env.*
!.env.example
# The production TEMPLATE (empty secrets, reference only) is meant to be committed.
!.env.production.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# runtime-generated evidence (local WORM-artifact store for CSV/Excel import — see
# backend/src/modules/inventory/import-evidence.store.ts). Per-environment output,
# not source.
backend/var/

# scripts/seed-demo.mjs's local state — the demo tenant's TOTP secret, which
# cannot be re-derived from the server. Per-machine, never a real secret.
scripts/.seed-demo-state.json

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
# scripts/local-db.mjs's embedded PostgreSQL data directory (a real database).
.localdb/
# Claude Code per-machine state (the shared .claude/launch.json stays tracked).
.claude/settings.local.json
.claude/worktrees/
# A stray directory once created by a mis-quoted shell command; holds a .env.
$generatedMfaKey*/

# installer build output (image tarballs, compiled .exe) — release
# artifacts, not source; generated by installer/scripts/package-images.ps1
# and `iscc`
installer/dist/
# The Windows Gateway installer's staging/cache and compiled setup .exe files
# (gateway-installer/scripts/build-agent-bundle.ps1 and `iscc`).
gateway-installer/build/
gateway-installer/dist/
